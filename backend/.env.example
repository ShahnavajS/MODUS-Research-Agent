ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./research_platform.db
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# AI Provider Configuration ("mock" | "gemini")
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Research Provider Configuration ("mock" | "web")
RESEARCH_PROVIDER=mock
RESEARCH_RESULTS_PER_QUERY=5
MAX_SUBQUESTIONS=5
MAX_SEARCH_QUERIES_PER_SUBQUESTION=2
CONTENT_EXTRACTION_TIMEOUT_SECONDS=10.0
MAX_DOCUMENT_SIZE_BYTES=500000

LOG_LEVEL=INFO
